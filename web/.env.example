# Copy to .env.local and fill in.

# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Same page, "service_role" key. Server-side only (never NEXT_PUBLIC_).
# Needed for grading since migration 009 hides the answer key from students.
SUPABASE_SERVICE_ROLE_KEY=

# The ML service (ml/, uvicorn main:app). Server-side only.
ML_URL=http://localhost:8000
# Must match ML_API_KEY in ml/.env. Leave empty for local development.
ML_API_KEY=

# AI tutor (app/api/explain). Set ONE of these. Server-side only.
# Groq is free: https://console.groq.com -> API Keys. Used when set.
GROQ_API_KEY=
# Optional, default openai/gpt-oss-120b.
GROQ_MODEL=
# Or Claude (paid), used only when GROQ_API_KEY is empty: https://platform.claude.com -> API keys.
# With neither key, the "Explain my mistake" button says the tutor is not set up.
ANTHROPIC_API_KEY=
