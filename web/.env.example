# Copy to .env.local and fill in.

# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The ML service (ml/, uvicorn main:app). Server-side only.
ML_URL=http://localhost:8000
# Must match ML_API_KEY in ml/.env. Leave empty for local development.
ML_API_KEY=

# AI tutor (app/api/explain). From https://platform.claude.com -> API keys.
# Server-side only. Without it the "Explain my mistake" button says so.
ANTHROPIC_API_KEY=
